<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppCadastroEventos.Views.CadastroEvento"
             Title="Cadastro do Evento"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray400}">
    
    <VerticalStackLayout VerticalOptions="CenterAndExpand"
                         Padding="10"
                         Spacing="10">

        <Label Text="Cadastro do Evento"
                FontSize="50"
                TextColor="#000080" />

        <Frame Padding="10">
            <VerticalStackLayout>

                <Frame Padding="10"
                       Margin="10">

                    

                    <VerticalStackLayout Spacing="20">
                        <!-- Nome do evento -->

                        <Label Text="Nome do Evento:" FontSize="16" TextColor="#FFD700" />
                        <Entry x:Name="txt_nomeEvento" 
                               Placeholder="Digite o nome do evento" 
                               TextColor="White"/>
                        <!-- Datas -->

                        <Label Text="Duração do Evento"
                               TextTransform="Uppercase"
                               FontSize="Subtitle"
                               TextColor="#000080"/>

                        <HorizontalStackLayout HorizontalOptions="CenterAndExpand">
                            <Label Text="Data de Ínicio:" 
                                   TextColor="#FFD700"/>
                            <DatePicker x:Name="dtpck_inicio"

                                        Format="dd/MM/yyyy" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout HorizontalOptions="CenterAndExpand">
                            <Label Text="Data de Término:" 
                                   TextColor="#FFD700"/>
                            <DatePicker x:Name="dtpck_termino"
                                        
                                        Format="dd/MM/yyyy" />
                        </HorizontalStackLayout>
                        <!-- N° de participantes -->

                        <Grid RowDefinitions="Auto, Auto"
                              ColumnDefinitions="*, *, 2*">

                            <Label Grid.Row="0" Grid.Column="0"
                                   Text="Participantes" 
                                   TextColor="#FFD700"/>

                            <Label Grid.Row="0" Grid.Column="1"
                                   TextColor="#000080"
                                   Text="{Binding Value}"
                                   BindingContext="{x:Reference stp_participantes}"/>

                            <Stepper Grid.Row="0" Grid.Column="2"
                                     x:Name="stp_participantes"
                                     Minimum="0"
                                     Maximum="100"
                                     Increment="1" />

                            
                        </Grid>
                        <!-- Local do evento -->

                        <Label Text="Local do Evento:" FontSize="16" TextColor="#FFD700" />
                        <Entry x:Name="txt_localEvento" 
                               Placeholder="Digite o local do evento" 
                               TextColor="White"/>
                        <!-- Custo por participante -->

                        <Label Text="Custo por Participante (R$):" FontSize="16" TextColor="#FFD700" />
                        <Entry x:Name="txt_custoParticipante" 
                               Placeholder="Ex: 50,00"
                               TextColor="White"/>

                    </VerticalStackLayout>
                </Frame>

                <Button Text="Avançar" Clicked="BotaoAvancar_Clicked"/>

            </VerticalStackLayout>
        </Frame>
        
    </VerticalStackLayout>
</ContentPage>